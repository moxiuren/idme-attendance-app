<?xml version="1.0" encoding="utf-8"?>
<!--
  禁止云备份与设备迁移带走本机数据（含登录凭据）。
  与 AndroidManifest 中 allowBackup="false" 配套，覆盖 API 31+ 的 dataExtractionRules 通道。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
